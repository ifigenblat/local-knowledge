# AI Service
PORT=5008

# Option A: OpenAI-compatible API (recommended: faster and more stable)
# Use with OpenAI, Groq (free tier), Together, Azure, etc.
OPENAI_API_KEY=
OPENAI_API_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Timeout for Cloud API / Ollama requests (ms). Default 300000 (5 min) for slow/local models.
# AI_CHAT_TIMEOUT_MS=300000

# Embeddings for Knowledge/RAG (optional; defaults to same as chat)
# LM Studio and similar local chat servers do NOT support embeddings. Use a cloud provider or Ollama.
# EMBED_API_URL=https://api.openai.com/v1
# EMBED_API_KEY=sk-...
# EMBED_MODEL=text-embedding-3-small
# Or use Ollama: ollama pull nomic-embed-text, set OLLAMA_ENABLED=true

# Option B: Ollama (local, no API key; can be unstable under load)
OLLAMA_API_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
OLLAMA_ENABLED=false
# For Knowledge Q&A, use a lighter model to avoid "model runner stopped" (OOM)
# KNOWLEDGE_OLLAMA_MODEL=llama3.2:1b
